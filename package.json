{
  "name": "rs-git",
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "preview": "npm run build && nodemon --watch main.js --watch adapter.js --watch start.js --exec \"node --env-file=.env start.js\"",
    "production": "node start.js",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --ui",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-node": "^5.5.1",
    "@sveltejs/kit": "^2.49.5",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.46.4",
    "vite": "^7.0.4",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "file-type": "^21.3.0",
    "mime": "^4.1.0",
    "normalize.css": "^8.0.1",
    "remotestorage-middleware": "0dataapp/remotestorage-middleware#0b2b19c",
    "simple-git": "^3.30.0",
    "token-store": "0dataapp/token-store#a9a27c1"
  }
}
